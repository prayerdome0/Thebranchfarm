rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function staff() { return signedIn() && userDoc().data.status == 'active' && userDoc().data.role in ['staff', 'admin']; }
    function admin() { return signedIn() && userDoc().data.status == 'active' && userDoc().data.role == 'admin'; }
    function safeImage() { return request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }

    // Cattle / animal photographs.
    match /animal-photos/{animalId}/{file} {
      allow read: if staff();
      allow write: if staff() && safeImage();
    }
    match /animal-photos/{animalId}/health/{file} {
      allow read: if staff();
      allow write: if staff() && safeImage();
    }

    // Farm documents: PDFs, images, Word, Excel, videos and other farm files.
    match /documents/{uid}/{file} {
      allow read: if staff();
      allow write: if staff() && request.resource.size < 50 * 1024 * 1024;
    }

    // Storefront product images: publicly visible; only admins upload.
    match /product-images/{file} {
      allow read: if true;
      allow write: if admin() && safeImage();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
