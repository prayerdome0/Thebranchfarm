rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().status == 'active'; }
    function hasRole(role) { return active() && profile().role == role; }
    function staff() { return hasRole('staff') || hasRole('admin'); }
    function admin() { return hasRole('admin'); }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function ownEmail(value) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && value is string
        && value.lower() == request.auth.token.email.lower();
    }
    function safeString(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optionalString(value, max) { return value == null || (value is string && value.size() <= max); }
    function nonNegative(value) { return value is number && value >= 0; }
    function validFarmCreate() {
      return staff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validFarmUpdate() {
      return staff()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validAnimal() {
      return request.resource.data.animalType in ['cattle', 'pig', 'chicken', 'goat', 'sheep', 'other']
        && safeString(request.resource.data.animalId, 80)
        && optionalString(request.resource.data.tagNumber, 120)
        && optionalString(request.resource.data.name, 120)
        && safeString(request.resource.data.breed, 100)
        && request.resource.data.sex in ['male', 'female']
        && request.resource.data.healthStatus in ['healthy', 'under-observation', 'sick', 'injured', 'recovering']
        && request.resource.data.status in ['active', 'sold', 'deceased', 'transferred', 'other']
        && safeString(request.resource.data.location, 150)
        && (request.resource.data.weight == null || nonNegative(request.resource.data.weight))
        && (request.resource.data.purchasePrice == null || nonNegative(request.resource.data.purchasePrice));
    }
    function validHealth() {
      return safeString(request.resource.data.animalId, 80)
        && request.resource.data.type in ['observation', 'problem', 'vaccination', 'treatment', 'examination', 'other']
        && safeString(request.resource.data.problem, 500)
        && safeString(request.resource.data.date, 20);
    }
    function validDocument() {
      return safeString(request.resource.data.name, 200)
        && request.resource.data.fileName is string
        && request.resource.data.fileType is string
        && nonNegative(request.resource.data.fileSize)
        && safeString(request.resource.data.category, 30)
        && request.resource.data.downloadUrl is string
        && request.resource.data.storagePath is string;
    }
    function validActivity() {
      return safeString(request.resource.data.activity, 120)
        && safeString(request.resource.data.date, 20)
        && safeString(request.resource.data.notes, 2000);
    }
    function validProduct() {
      return safeString(request.resource.data.name, 120)
        && request.resource.data.kind in ['produce', 'livestock']
        && safeString(request.resource.data.category, 40)
        && safeString(request.resource.data.description, 2000)
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && safeString(request.resource.data.unit, 30)
        && nonNegative(request.resource.data.stock)
        && request.resource.data.active is bool
        && request.resource.data.trackInventory is bool;
    }
    function validOrder() {
      return safeString(request.resource.data.reference, 30)
        && request.resource.data.status in ['pending', 'confirmed', 'processing', 'ready', 'completed', 'cancelled']
        && request.resource.data.paymentStatus in ['unpaid', 'paid']
        && request.resource.data.fulfillment in ['pickup', 'delivery']
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && request.resource.data.deliveryFee is number;
    }

    match /users/{uid} {
      allow create: if own(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && (request.auth.token.email == null
            || request.resource.data.email.lower() == request.auth.token.email.lower())
        && safeString(request.resource.data.fullName, 100)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24;
      allow read: if own(uid) || admin();
      // Members maintain their own contact details; administrators may also fix
      // a colleague's name, phone or job title. Role, status and permissions
      // stay callable-only (admin Cloud Functions) so access cannot be
      // escalated from the client.
      allow update: if (own(uid) || admin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'title', 'photoURL', 'updatedAt', 'lastLoginAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    // Animals are operational records: staff add/update them; only an admin
    // may permanently delete one. Sales/transfers change status instead.
    match /animals/{id} {
      allow read: if staff();
      allow create: if staff() && validFarmCreate() && validAnimal();
      allow update: if staff() && validFarmUpdate() && validAnimal();
      allow delete: if admin();
    }

    // Health records: staff record problems/observations; admin can remove.
    match /animalHealth/{id} {
      allow read: if staff();
      allow create: if staff() && validFarmCreate() && validHealth();
      allow update: if staff() && validFarmUpdate() && validHealth();
      allow delete: if admin();
    }

    // Farm documents: staff upload metadata; admin can remove.
    match /farmDocuments/{id} {
      allow read: if staff();
      allow create: if staff() && validFarmCreate() && validDocument();
      allow update: if staff() && validFarmUpdate() && validDocument();
      allow delete: if admin();
    }

    // Activity / records log.
    match /farmActivities/{id} {
      allow read: if staff();
      allow create: if staff() && validFarmCreate() && validActivity();
      allow update: if staff() && validFarmUpdate() && validActivity();
      allow delete: if admin();
    }

    function validOperation() {
      return request.resource.data.module in [
          'weight', 'breeding', 'birth', 'acquisition', 'movement',
          'feed', 'inventory', 'milk', 'eggs', 'daily-log', 'incident',
          'task', 'equipment', 'maintenance', 'expense'
        ]
        && safeString(request.resource.data.reference, 80)
        && safeString(request.resource.data.title, 300)
        && safeString(request.resource.data.date, 20)
        && request.resource.data.values is map
        && request.resource.data.reviewStatus in ['not-required', 'pending', 'approved', 'rejected'];
    }
    function reviewUpdateAllowed() {
      return admin() || (
        request.resource.data.reviewStatus in ['not-required', 'pending']
        && request.resource.data.get('reviewedBy', null) == resource.data.get('reviewedBy', null)
        && request.resource.data.get('reviewedByName', null) == resource.data.get('reviewedByName', null)
        && request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null)
        && request.resource.data.get('reviewNote', null) == resource.data.get('reviewNote', null)
      );
    }
    function taskUpdateAllowed() {
      return resource.data.module != 'task'
        || admin()
        || (
          resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.values.diff(resource.data.values).affectedKeys()
            .hasOnly(['status', 'completionDate', 'completionNote'])
        );
    }
    function archiveUpdateAllowed() {
      return admin()
        || request.resource.data.get('archived', false) == resource.data.get('archived', false);
    }

    // The operational center. Important writes are stamped and committed with
    // an immutable audit event by the client data layer.
    match /farmOperations/{id} {
      allow read: if staff();
      allow create: if staff() && validFarmCreate() && validOperation()
        && (request.resource.data.module != 'task' || admin());
      allow update: if staff() && validFarmUpdate() && validOperation()
        && reviewUpdateAllowed() && taskUpdateAllowed() && archiveUpdateAllowed();
      allow delete: if false;
    }

    // Append-only Who → What → When ledger. Neither staff nor admins can edit
    // or delete an event after it is written.
    match /auditTrail/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.action in ['created', 'updated', 'approved', 'rejected', 'archived', 'deleted', 'status-changed']
        && safeString(request.resource.data.entityType, 80)
        && safeString(request.resource.data.entityId, 160)
        && safeString(request.resource.data.entityLabel, 240)
        && safeString(request.resource.data.description, 1000);
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      // Public so the storefront can show currency/delivery; only admins edit.
      allow read: if settingId == 'farm';
      allow write: if admin() && settingId == 'farm';
    }

    // Storefront: public read of the catalogue; staff add and edit, admin removes.
    match /products/{id} {
      allow read: if true;
      allow create: if staff() && validProduct();
      allow update: if staff() && validProduct();
      allow delete: if admin();
    }

    // Videos and gallery media are public on the farm site; staff upload and
    // maintain them, while only administrators permanently remove records.
    match /videos/{id} {
      allow read: if true;
      allow create: if staff() && safeString(request.resource.data.title, 160)
        && safeString(request.resource.data.category, 60)
        && request.resource.data.videoUrl is string
        && request.resource.data.storagePath is string;
      allow update: if staff();
      allow delete: if admin();
    }
    match /media/{id} {
      allow read: if true;
      allow create: if staff() && validFarmCreate()
        && request.resource.data.fileUrl is string
        && request.resource.data.resourceType in ['image', 'video'];
      allow update: if staff() && validFarmUpdate();
      allow delete: if admin();
    }

    // Customers: a guest's order auto-creates the customer record; staff
    // maintain the list. Only minimal, validated fields may be written by an
    // anonymous checkout so the collection cannot be used for spam.
    function validCustomer() {
      return safeString(request.resource.data.phone, 30)
        && safeString(request.resource.data.name, 120)
        && (request.resource.data.orders == null || (request.resource.data.orders is number && request.resource.data.orders >= 0))
        && (request.resource.data.totalSpent == null || (request.resource.data.totalSpent is number && request.resource.data.totalSpent >= 0));
    }
    match /customers/{id} {
      allow read: if staff();
      allow create: if validCustomer();
      allow update: if staff();
      allow delete: if false;
    }

    // Orders: guests place orders (no sign-in); only staff can list/update.
    match /orders/{id} {
      allow read: if staff() || ownEmail(resource.data.customer.email);
      allow create: if true && validOrder();
      allow update: if staff();
      allow delete: if admin();
    }

    // Business documents: quotations, receipts and invoices are managed by
    // staff. The browser stores the full record (items, totals, signature
    // data-URL, Cloudinary URL and public ID); deletion is admin-only.
    match /quotations/{id} {
      allow read: if staff() || ownEmail(resource.data.customerEmail);
      allow create, update: if staff();
      allow delete: if admin();
    }
    match /receipts/{id} {
      allow read: if staff() || ownEmail(resource.data.customerEmail);
      allow create, update: if staff();
      allow delete: if admin();
    }
    match /invoices/{id} {
      allow read: if staff();
      allow create, update: if staff();
      allow delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
