# Firebase client identifiers (public project identifiers only — data access is
# protected by Auth + Firestore Rules). OPTIONAL: the production `thebranchfarm`
# project's identifiers ship as code-level defaults in src/lib/firebase/config.ts,
# so sign-in works without these variables. Set them only to point this build at
# a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Firebase Admin for protected Next.js API routes. Keep server-only.
FIREBASE_ADMIN_PROJECT_ID=your_project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

INITIAL_ADMIN_EMAILS=owner@example.com

# Media storage (server-only). The browser never receives these — uploads are
# POSTed to /api/uploads, signed server-side and forwarded. Use ONE cloud, no
# folders; recordType + recordId in the database identify ownership.
# Either set CLOUDINARY_URL …
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME
# … or the discrete variables:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Password that protects the admin user-guide PDF. Admin-controlled, never
# displayed in the UI, never included in frontend code. Keep it strong and
# share it with administrators through a secure channel.
GUIDE_PDF_PASSWORD=choose_a_strong_guide_password

# Optional site URL for sitemap/SEO
NEXT_PUBLIC_SITE_URL=https://thebranchfarm.com
