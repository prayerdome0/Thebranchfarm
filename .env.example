# Firebase client config (public identifiers; rules protect data)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thebranchfarm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thebranchfarm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thebranchfarm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=971662070100
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Firebase Admin for protected Next.js API routes. Keep server-only.
FIREBASE_ADMIN_PROJECT_ID=thebranchfarm
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

INITIAL_ADMIN_EMAILS=owner@example.com

# Cloudinary — ONE cloud, ONE unsigned preset, NO FOLDERS
# Exact spec from brief:
# cloud_name: dhad95cch
# upload_preset: branch_farm (unsigned)
# signing: unsigned, overwrite: false, use_filename: false, unique_filename: false, use_filename_as_display_name: true, use_asset_folder_as_public_id_prefix: false, resource_type: upload, folders: NONE
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dhad95cch
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=branch_farm

# Server-only — never commit, never expose publicly
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@dhad95cch

# Optional site URL for sitemap/SEO
NEXT_PUBLIC_SITE_URL=https://thebranchfarm.com
